# Copy to .env.local for local development. Never commit real values.

# Optional but strongly recommended for deployment.
# A GitHub token raises the API limit from 60 to 5,000 requests/hour (each scan uses 4).
# Create a fine-grained personal access token with "Public repositories (read-only)" access
# and NO additional permissions: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional: analyses allowed per client IP per 10 minutes, per server instance (default 10).
RATE_LIMIT_PER_10_MIN=10
